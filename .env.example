# ============================================================
# AI Tutor — Cost-Optimized Configuration
# ============================================================
# LLM: Ollama (free, local) or OpenAI (paid, cloud fallback)
# Embeddings: Always Ollama (free, local)
# ============================================================

ENV=development
DEBUG=true
SECRET_KEY=dev-secret-change-me-minimum-32-chars-long

DATABASE_URL=postgresql+asyncpg://tutor:tutor@postgres:5432/tutor
REDIS_URL=redis://redis:6379/0

# --- LLM (choose one) ---
# Option 1: Ollama (FREE)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_MEDIUM=gpt-oss:20b

# Option 2: OpenAI (PAID) — uncomment and comment Option 1
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=sk-xxxxx
# LLM_MODEL_MEDIUM=gpt-4o-mini

# --- Embeddings (always free, always Ollama) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

CORS_ORIGINS=["http://localhost:3000"]